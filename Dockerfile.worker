FROM python:3.9-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements-v4.txt .
RUN pip install --no-cache-dir -r requirements-v4.txt

# Copy application code
COPY . .

# Run worker (Placeholder since no Celery app found)
CMD ["python3", "-c", "import time; print('Worker started... waiting for tasks'); while True: time.sleep(60)"]
